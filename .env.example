# ═══════════════════════════════════════════════════════════════
# CALLATE Y BAILA! — Frontend (campamento-web)
# ═══════════════════════════════════════════════════════════════
# Copiá este archivo como .env y completá los valores:
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
#
# IMPORTANTE sobre las variables VITE_*:
#   Estas variables se leen en TIEMPO DE COMPILACIÓN (npm run build)
#   y quedan QUEMADAS en el JavaScript generado en dist/
#   Si cambiás una variable, tenés que recompilar (npm run build)
#   El .env de desarrollo (npm run dev) sí se lee en tiempo real
# ═══════════════════════════════════════════════════════════════

# ── URL DE LA API ───────────────────────────────────────────────
# URL base para todas las llamadas al backend
#
# OPCIÓN 1 — Relativa "/api" (RECOMENDADA para producción)
#   El navegador completa la URL con el mismo origen
#   Funciona en cualquier servidor sin recompilar
#   Requiere que el backend sirva el frontend (FRONTEND_DIST configurado)
#   VITE_API_URL=/api
#
# OPCIÓN 2 — URL absoluta (para desarrollo con puertos separados)
#   Usá cuando Vite y el backend corren en puertos distintos
#   Y no querés usar el proxy de Vite
#   VITE_API_URL=http://localhost:8090
#
# Con el proxy de Vite configurado en vite.config.ts,
# podés usar /api incluso en desarrollo
VITE_API_URL=/api

# ── SERVIDOR DE DESARROLLO ──────────────────────────────────────
# Puerto donde corre Vite en modo desarrollo (npm run dev)
# Default: 5174 (para no chocar con el 5173 u otros proyectos)
# No afecta el build de producción
VITE_PORT=5174

# ── PROXY DE VITE (solo desarrollo) ─────────────────────────────
# URL del backend al que Vite redirige las requests de /api/*
# Solo se usa en desarrollo con "npm run dev"
# No afecta el build de producción (npm run build)
#
# Debe coincidir con APP_PORT del backend
VITE_BACKEND_URL=http://localhost:8090